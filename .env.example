# Salin menjadi .env lalu sesuaikan bila perlu.
SECRET_KEY=ganti-dengan-secret-key-acak

# DEBUG hanya berlaku untuk `runserver` lokal.
# Container Docker selalu memakai DEBUG=False (diatur di docker-compose.yml).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Kosongkan DATABASE_URL untuk memakai SQLite (mode pengembangan lokal).
# Saat memakai docker compose, DATABASE_URL diisi otomatis ke service `db`.
# Untuk PostgreSQL di luar Docker, isi seperti contoh berikut.
# DATABASE_URL=postgres://qc:qc@localhost:5432/qc_db

QC_DEFECT_RATE_THRESHOLD=3.0

# Identitas aplikasi (opsional, ada nilai bawaan di settings.py).
# APP_NAME=QCMS
# APP_DESCRIPTION=Quality Control Management System
# Isi bila aplikasi dipakai di perusahaan tertentu; dikosongkan untuk demo publik.
# APP_COMPANY=PT Contoh Manufaktur Indonesia

# Opsional: dipakai saat DEBUG=False di belakang reverse proxy HTTPS.
# CSRF_TRUSTED_ORIGINS=https://qcms.example.com

# Aktifkan bila aplikasi disajikan lewat HTTPS (mis. Render/Cloudflare).
# Jangan diaktifkan untuk Docker lokal di http://localhost:8080.
# HTTPS_ENABLED=True

# Menampilkan banner "data demo" di semua halaman.
# DEMO_MODE=True
