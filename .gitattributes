# Normalisasi akhir baris agar konsisten di Windows, macOS, dan Linux.
# Script shell wajib LF: shebang dengan CRLF membuat container gagal start
# dengan pesan "exec /app/entrypoint.sh: no such file or directory".
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf

# File biner: jangan diubah.
*.png binary
*.webp binary
*.jpg binary
*.ico binary
*.xlsx binary
